---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import ArticleReferences from "../../components/ArticleReferences.astro";
import SpecHeader from "../../components/SpecHeader.astro";
import StructuredData from "../../components/StructuredData.astro";
import { resolveAuthors } from "../../data/authors";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { articleBreadcrumbs } from "../../lib/breadcrumbs";

export async function getStaticPaths() {
  const concepts = await getCollection("concepts");
  return concepts.map((concept) => ({
    params: { slug: concept.id },
    props: { concept },
  }));
}

interface Props {
  concept: CollectionEntry<"concepts">;
}

const { concept } = Astro.props;
const { Content } = await render(concept);

// Generate canonical URL for structured data
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Build breadcrumb trail for BreadcrumbList JSON-LD
const breadcrumbs = articleBreadcrumbs(
  "concepts",
  concept.data.longTitle ?? concept.data.title,
  canonicalURL.toString(),
);

// Resolve authors for metadata and JSON-LD
const resolvedAuthors = resolveAuthors(concept.data.authors);
const authorNames = resolvedAuthors.map((a) => a.name).join(", ");

// Prepare structured data for Schema.org TechArticle
const structuredDataProps = {
  title: concept.data.longTitle ?? concept.data.title,
  longTitle: concept.data.longTitle,
  description: concept.data.description,
  authors: concept.data.authors,
  keywords: concept.data.tags?.join(", "),
  datePublished: (concept.data.publishedDate ?? concept.data.lastUpdated).toISOString(),
  dateModified: concept.data.lastUpdated.toISOString(),
  url: canonicalURL.toString(),
  articleSection: "Concepts",
};
---

<StructuredData type="TechArticle" data={structuredDataProps} />
<StructuredData type="BreadcrumbList" data={{ itemListElement: breadcrumbs }} />

<BaseLayout
  title={concept.data.longTitle ?? concept.data.title}
  description={concept.data.description}
  type="article"
  author={authorNames}
>
  <article class="concept-detail">
    <SpecHeader
      data={concept.data}
    />

    <div class="prose content-prose">
      <Content />
    </div>

    <ArticleReferences references={concept.data.references} />
  </article>
</BaseLayout>
